# Conexión a MongoDB Atlas.
# No incluir credenciales reales en este archivo.
MONGODB_URI=

# Puerto del backend.
PORT=3000

# development | production
NODE_ENV=development

# Orígenes permitidos separados por coma (CORS con credentials).
# Incluye los dos orígenes locales utilizados por el proyecto.
CLIENT_ORIGINS=http://localhost:5173,http://localhost:5177

# Fase 5: autenticación administrativa.
# JWT_SECRET debe definirse en producción; no incluir un valor real aquí.
JWT_SECRET=
JWT_EXPIRES_IN=8h
